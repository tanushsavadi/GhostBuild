# Copy to .env (gitignored) and fill locally. Names only — never commit values.

# Creao compiler (server-side only; values come from the agent's API Trigger panel on agent.creao.ai)
CREAO_API_KEY=
CREAO_TRIGGER_URL=
# optional: CREAO_AUTH_HEADER=X-API-Key   CREAO_BODY_TEMPLATE={"input": "{message}"}
# Public URL Creao's cloud uses to reach /procedures/validate and /agent/webhook (Tailscale Funnel / tunnel)
GB_PUBLIC_URL=
# Shared secret the agent sends as X-GhostBuild-Token on the webhook
GB_WEBHOOK_TOKEN=
# Feature flags (0 = off): compile endpoint, voice "teach me to ..." starts a compile
GB_CREAO=0
GB_VOICE_COMPILE=0

# G2 hold-to-talk speech-to-text (server-side only). Voice is on once a key is set; GB_VOICE=0 turns it off.
ELEVENLABS_API_KEY=
# optional: ELEVENLABS_STT_MODEL=scribe_v1
# dev only, no key needed: GB_STT_FAKE=which leg is longer
GB_VOICE=1

# knowledge/ build-time tooling only (claude-opus-5-5)
ANTHROPIC_API_KEY=
