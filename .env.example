# Copy to .env (gitignored) and fill locally. Names only — never commit values.
# Real values live in the team password manager.

# knowledge/ only (build-time manual extraction, claude-opus-5-5)
ANTHROPIC_API_KEY=

# integrations/sentry_bridge (required unless --dry-run); optional in integrations/fetch_agent
SENTRY_DSN=

# integrations/fetch_agent — REQUIRED, no default. Set to the core host, e.g. http://<MAC1-LAN-IP>:8787
GB_CORE_URL=
# 0 = demo-safe (default); 1 only while demoing with approval cards
GB_AGENT_ARMED=0
# uAgent seed phrase (integrations/fetch_agent)
AGENT_SEED=

# Open Palm laptop server (tools/open_palm_server.py)
ELEVENLABS_API_KEY=
CREAO_API_KEY=
# ID of the "Open Palm conversation prep" agent (agent.creao.ai/apps/<ID>)
CREAO_PREP_APP_ID=
