# Copy to .env (gitignored). Values belong in the backend environment only.
# These example settings keep provider calls OFF. Core loads this file at startup.

# Optional Anthropic interview, grounded Q&A, source search and compilation.
ANTHROPIC_API_KEY=
GB_ASSISTANT=0
GB_BRAIN_MODEL=claude-opus-5-5
GB_BRAIN_FAST=1
GB_COMPILE_MODEL=claude-opus-5-5

# Cached guides/product discovery work without a provider key.
GB_COMPILED_CARDS=1
GB_DISCOVERY=1
GB_DISCOVERY_LIVE=0
# Optional unknown-product manual-research wiring is mock-tested; leave off.
GB_DISCOVERY_RESEARCH=0

# Optional paid asynchronous live research. Results are labelled NOT HUMAN-REVIEWED.
# compile = Anthropic source search/compile; creao = configured CREAO app runs.
GB_LIVE_RESEARCH=0
GB_RESEARCH_ENGINE=compile
GB_LIVE_RESEARCH_MAX=3

# Optional CREAO research/review. Use your app ID and a random local admin token.
# Explicit review keeps a draft until approval. Opt-in live research is separate.
GB_CREAO=0
CREAO_API_KEY=
CREAO_APP_ID=
GB_ADMIN_TOKEN=

# Optional consented ElevenLabs voice. Text/gestures/visuals need no key.
# For G2 capture, also build the plugin with VITE_FLAG_VOICE=1 (not a secret).
GB_VOICE=0
GB_TTS=0
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Select an account-available voice. Output is phone/earbuds; G2 has no speaker.
ELEVENLABS_VOICE_ID=

# Historical optional integrations, separate from the current product path.
# integrations/sentry_bridge (required unless --dry-run)
SENTRY_DSN=
# integrations/fetch_agent: core URL and agent seed, backend only.
GB_CORE_URL=
GB_AGENT_ARMED=0
AGENT_SEED=
