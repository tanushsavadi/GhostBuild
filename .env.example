# Copy to .env (gitignored) and fill locally. Names only — never commit values.
# Real values live in the team password manager.

# knowledge/ only (build-time manual extraction, claude-opus-5-5)
ANTHROPIC_API_KEY=

# Optional ElevenLabs voice. Backend only; touch/text/visual guidance needs no key.
GB_VOICE=0
GB_TTS=0
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Select a voice available to your account; never clone a person without permission.
ELEVENLABS_VOICE_ID=

# Existing asynchronous CREAO agent. No draft reaches G2 until a human approves.
GB_CREAO=0
CREAO_API_KEY=
CREAO_APP_ID=032b9dc5-2fc7-4b5d-af36-8efdbd2648ac
# Generate a random local admin token; enter it only in the research review form.
GB_ADMIN_TOKEN=

# integrations/sentry_bridge (required unless --dry-run); optional in integrations/fetch_agent
SENTRY_DSN=

# integrations/fetch_agent — REQUIRED, no default. Set to the core host, e.g. http://<MAC1-LAN-IP>:8787
GB_CORE_URL=
# 0 = demo-safe (default); 1 only while demoing with approval cards
GB_AGENT_ARMED=0
# uAgent seed phrase (integrations/fetch_agent)
AGENT_SEED=
