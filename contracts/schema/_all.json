          "type": "string"
        },
        "seq_seen": {
          "description": "last hud seq the plugin had rendered",
          "minimum": 0,
          "title": "Seq Seen",
          "type": "integer"
        },
        "surface": {
          "default": "g2",
          "enum": [
            "g2",
            "simulator"
          ],
          "title": "Surface",
          "type": "string"
        },
        "type": {
          "const": "g2_input",
          "default": "g2_input",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 2,
          "default": 2,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "gesture",
        "seq_seen"
      ],
      "title": "G2Input",
      "type": "object"
    },
    "GoalRequest": {
      "additionalProperties": false,
