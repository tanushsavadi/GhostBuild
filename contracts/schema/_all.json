          "default": "",
          "maxLength": 26,
          "title": "Line2",
          "type": "string"
        }
      },
      "required": [
        "line1"
      ],
      "title": "Cue",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "description": "core epoch ms",
          "title": "At",
          "type": "integer"
        },
        "evidence": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
