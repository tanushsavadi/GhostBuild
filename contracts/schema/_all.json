{
  "$defs": {
    "CameraObs": {
      "additionalProperties": false,
      "description": "What the Pi measured from the latest frame. Features only; the core decides what they mean.",
      "properties": {
        "detail": {
          "description": "variance of Laplacian (focus/detail); low when covered or defocused",
          "minimum": 0,
          "title": "Detail",
          "type": "number"
        },
        "frame_age_ms": {
          "description": "age of the frame when this observation was built",
          "minimum": 0,
          "title": "Frame Age Ms",
          "type": "integer"
        },
        "frame_seq": {
          "description": "increments once per NEW frame; a stuck value means a frozen feed",
          "minimum": 0,
          "title": "Frame Seq",
          "type": "integer"
        },
        "luma_std": {
          "description": "contrast; a covered lens is dark AND flat",
          "minimum": 0,
          "title": "Luma Std",
          "type": "number"
        },
        "marker_found": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fiducial/marker seen in the fixed field of view; null = not evaluated",
          "title": "Marker Found"
        },
        "marker_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker Id"
        },
        "mean_luma": {
          "maximum": 255,
          "minimum": 0,
          "title": "Mean Luma",
          "type": "number"
        },
        "motion": {
          "description": "fraction of ROI pixels changed vs the previous frame",
          "maximum": 1,
          "minimum": 0,
          "title": "Motion",
          "type": "number"
        }
      },
      "required": [
        "frame_seq",
        "frame_age_ms",
        "mean_luma",
        "luma_std",
        "detail",
        "motion"
      ],
      "title": "CameraObs",
      "type": "object"
    },
    "Card": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "description": "lowercase phrases the deterministic goal resolver matches, e.g. 'camera', 'inspection station'",
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "functional": {
          "anyOf": [
            {
              "$ref": "#/$defs/Functional"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "goal_mode": {
          "default": "fix",
          "description": "fix = repair/diagnose; build = guided supported setup",
          "enum": [
            "fix",
            "build"
          ],
          "title": "Goal Mode",
          "type": "string"
        },
        "guides": {
          "items": {
            "$ref": "#/$defs/Guide"
          },
          "title": "Guides",
          "type": "array"
        },
        "provenance": {
          "enum": [
            "MEASURED LIVE",
            "INFERRED",
            "COMMANDED",
            "DETERMINISTIC",
            "HUMAN CONFIRMED",
            "MANUFACTURER DOC",
            "AUTHORED PROJECT SPEC",
            "AI-EXTRACTED \u00b7 HUMAN-REVIEWED",
            "AUTHORED DEMO METADATA",
            "REPLAY",
            "SIMULATED"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source_"
          },
          "title": "Sources",
          "type": "array"
        },
        "tests": {
          "items": {
            "$ref": "#/$defs/Test"
          },
          "minItems": 1,
          "title": "Tests",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "v": {
          "const": 2,
          "default": 2,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "card_id",
        "title",
        "provenance",
        "sources",
        "tests"
      ],
      "title": "Card",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/Cue"
        },
        "cites": {
          "items": {
