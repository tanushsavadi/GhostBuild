        "label"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Functional": {
      "additionalProperties": false,
      "description": "Post-repair functional demonstration. Success is a measured camera fact; the LED is only COMMANDED.",
      "properties": {
        "expect_commanded": {
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ok": {
          "$ref": "#/$defs/Cue"
        },
        "prompt": {
          "$ref": "#/$defs/Cue"
        },
        "trigger": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "Trigger",
          "type": "array"
        },
        "within_ms": {
          "minimum": 0,
          "title": "Within Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "trigger",
        "prompt",
        "ok",
        "within_ms"
      ],
      "title": "Functional",
      "type": "object"
    },
    "G2Hello": {
      "additionalProperties": false,
      "description": "First message on every (re)connect. Core replies with the current frame. Welcome shows only when session_id is null/unknown.",
      "properties": {
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "surface": {
          "default": "g2",
          "enum": [
            "g2",
            "simulator"
          ],
          "title": "Surface",
          "type": "string"
        },
        "type": {
          "const": "g2_hello",
          "default": "g2_hello",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 2,
          "default": 2,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "client_id"
      ],
      "title": "G2Hello",
      "type": "object"
    },
    "G2Input": {
      "additionalProperties": false,
      "description": "Double press is handled locally (system exit) and never sent. A press is a recheck/help request, never a commit.",
      "properties": {
        "gesture": {
          "enum": [
            "press",
            "swipe_down",
            "swipe_up",
            "hold_start",
            "hold_end"
