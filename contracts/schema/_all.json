    "HudFrame": {
      "additionalProperties": false,
      "description": "The only thing G2 renders. Written by core/ghostbuild_core/hud.py and nothing else.",
      "properties": {
        "cue": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cue"
            },
            {
              "type": "null"
            }
          ],
