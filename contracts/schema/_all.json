              {
                "type": "null"
              }
            ]
          },
          "title": "Evidence",
          "type": "object"
        },
        "label": {
          "enum": [
            "MEASURED LIVE",
            "INFERRED",
            "COMMANDED",
            "DETERMINISTIC",
            "HUMAN CONFIRMED",
            "MANUFACTURER DOC",
            "AUTHORED PROJECT SPEC",
            "AI-EXTRACTED \u00b7 HUMAN-REVIEWED",
            "AUTHORED DEMO METADATA",
            "REPLAY",
            "SIMULATED"
          ],
          "title": "Label",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
