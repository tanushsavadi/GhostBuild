            "intervene",
            "visual",
            "ask",
            "verified",
            "uncertain",
            "error"
          ],
          "title": "Mode",
          "type": "string"
        },
        "seq": {
          "description": "monotonic; unchanged frames are never re-sent",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
