        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "present only in visual mode; cue is the text fallback"
        },
        "menu": {
          "anyOf": [
            {
              "$ref": "#/$defs/Menu"
