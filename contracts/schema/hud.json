{
  "additionalProperties": false,
  "description": "Core -> G2. Written only by core/ghostbuild_core/hud.py. The plugin shows `lines` joined by newlines.",
  "properties": {
    "kind": {
      "enum": [
        "idle",
        "step",
        "checking",
        "verified",
        "confirmed",
        "fault",
        "answer",
        "troubleshoot",
        "complete",
        "clear",
        "status",
        "offline"
      ],
      "title": "Kind",
      "type": "string"
    },
    "lines": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Lines",
      "type": "array"
    },
    "mode": {
      "anyOf": [
        {
          "enum": [
            "VERIFIED",
            "GUIDED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mode"
    },
    "procedure_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Procedure Id"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "source": {
      "default": "live",
      "enum": [
        "live",
        "simulated",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    },
    "step_index": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step Index"
    },
    "step_total": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step Total"
    },
    "ttl_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Plugin clears locally after this, as a fallback",
      "title": "Ttl Ms"
    },
    "type": {
      "const": "hud",
      "default": "hud",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "kind",
    "lines"
  ],
  "title": "HudFrame",
  "type": "object"
}
