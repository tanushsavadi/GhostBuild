        "line1": "ARROW DECIDES THE GRIP",
        "line2": ""
      },
      "where": {
        "line1": "ROUND HOLES ON THE EDGES",
        "line2": ""
      },
      "warnings": [
        "Do not overtighten: a quarter turn is enough."
      ],
      "faq": [
        {
          "q": "how tight should it be",
          "a": {
            "line1": "QUARTER TURN, THEN STOP",
            "line2": ""
          }
        },
        {
          "q": "what if the arrow is wrong",
          "a": {
            "line1": "LIFT IT OUT, TURN IT",
            "line2": ""
          }
        }
