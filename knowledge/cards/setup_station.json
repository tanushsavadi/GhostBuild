  "tests": [
    {
      "id": "camera_frames",
      "fail_when": [
        {
          "signal": "camera",
          "op": "is_null",
          "value": null
        }
      ],
      "fail_after_ms": 1500,
      "pass_after_ms": 1000,
      "fact": {
        "line1": "CAMERA NOT FOUND",
        "line2": "CHECK CAMERA CONNECTION"
      },
      "ok": {
        "line1": "● CAMERA LIVE",
        "line2": ""
      },
      "checks": [
        {
          "when": [],
          "action": {
            "line1": "CHECK CAMERA",
            "line2": "CONNECTION"
          },
          "why": "No camera frames arrived from the Pi. The fetched Raspberry Pi page covers camera installation, but its cable wording was not verified verbatim, so the cue stays generic.",
          "cites": [
            {
              "source": "picam_docs",
              "loc": "camera installation section",
              "quote": null
            }
          ],
          "guide_id": null
        }
      ],
      "offer_help_after_ms": 8000
    },
    {
      "id": "scene_visible",
      "fail_when": [
        {
          "signal": "camera.mean_luma",
          "op": "lt",
          "value": 25
        }
      ],
      "fail_after_ms": 1500,
      "pass_after_ms": 1000,
      "fact": {
        "line1": "CAMERA VIEW DARK",
        "line2": "CHECK CAMERA LENS"
      },
      "ok": {
        "line1": "● SCENE VISIBLE",
        "line2": ""
      },
      "checks": [
        {
          "when": [],
          "action": {
            "line1": "CHECK CAMERA LENS",
            "line2": ""
          },
          "why": "The fixed field of view is dark. The lens may be covered. Placeholder threshold, calibrate on the Pi spike.",
          "cites": [],
          "guide_id": "camera_lens"
        }
      ],
      "offer_help_after_ms": 8000
    }
  ],
  "functional": {
    "id": "led_on_motion",
    "trigger": [
      {
        "signal": "camera.motion",
        "op": "gt",
        "value": 0.15
      }
    ],
    "prompt": {
      "line1": "WAVE IN FRONT",
      "line2": "OF THE CAMERA"
    },
    "expect_commanded": {
      "signal": "led.commanded_on",
      "op": "eq",
      "value": true
    },
    "ok": {
      "line1": "● LED COMMANDED",
      "line2": ""
    },
    "within_ms": 1500
  },
