    }
  ],
  "tests": [
    {
      "id": "camera_view",
      "fail_when": [
        {
          "signal": "camera.mean_luma",
          "op": "lt",
          "value": 25
        },
        {
          "signal": "camera.luma_std",
          "op": "lt",
          "value": 8
        }
      ],
      "fail_after_ms": 1500,
      "pass_after_ms": 1000,
      "fact": {
        "line1": "CAMERA VIEW LOST",
        "line2": "CHECK CAMERA LENS"
      },
      "ok": {
        "line1": "● CAMERA VIEW BACK",
        "line2": ""
      },
      "checks": [
        {
          "when": [
            {
              "signal": "camera.mean_luma",
              "op": "lt",
              "value": 25
            }
          ],
          "action": {
            "line1": "CHECK CAMERA LENS",
            "line2": ""
          },
          "why": "Dark and flat frames mean little light reaches the sensor. A lens cover or paper flap is the first thing to check. Placeholder threshold, calibrate on the Pi spike.",
          "cites": [],
          "guide_id": "camera_lens"
        }
      ],
      "offer_help_after_ms": 8000
    }
  ],
  "functional": {
    "id": "led_on_motion",
    "trigger": [
      {
        "signal": "camera.motion",
        "op": "gt",
        "value": 0.15
      }
    ],
    "prompt": {
      "line1": "WAVE IN FRONT",
      "line2": "OF THE CAMERA"
    },
    "expect_commanded": {
      "signal": "led.commanded_on",
      "op": "eq",
      "value": true
    },
    "ok": {
      "line1": "● LED COMMANDED",
      "line2": ""
    },
    "within_ms": 1500
  },
