    {
      "id": "square",
      "title": "Start with a square sheet",
      "cue": {
        "line1": "USE A SQUARE SHEET",
        "line2": "NOT SQUARE? SEE PHONE"
      },
      "detail": "The tutorial says: Any square sheet will work. If you only have a rectangular sheet of printer paper, the origami.me page 'How to Make Rectangular Paper into a Square' does it in three steps: fold the left edge down to the bottom edge and pinch at the top right corner, then unfold; fold the right edge over using the pinch as a guide, crease and unfold; cut off the right strip along the crease. That page says it needs a cut, so have scissors ready. UNCERTAIN: the cup page itself does not describe squaring.",
      "why": {
        "line1": "THE CUP PAGE ASSUMES",
        "line2": "A SQUARE SHEET"
      },
      "where": {
        "line1": "PAPER ON A FLAT TABLE",
        "line2": ""
      },
      "warnings": [
        "Scissors are needed only if you must square a rectangular sheet."
      ],
      "faq": [
        {
          "q": "what if my paper is not square",
          "a": {
            "line1": "MAKE IT SQUARE FIRST",
            "line2": "SEE THE PHONE STEPS"
          }
        },
        {
          "q": "can i use printer paper",
          "a": {
            "line1": "YES, MAKE IT SQUARE",
            "line2": "SOURCE SAYS IT WORKS"
          }
        }
      ],
      "troubleshoot": [
        {
          "when": [],
          "action": {
            "line1": "CHECK SHEET SQUARE",
            "line2": "ALL SIDES EQUAL"
          },
          "why": "The cup tutorial is written for a square sheet.",
          "cites": [
            {
              "source": "origami_me_cup",
              "loc": "Recommended Paper",
              "quote": "Any square sheet will work.",
              "url": "https://origami.me/cup/"
            },
            {
              "source": "origami_me_square",
              "loc": "Intro",
              "quote": "You can easily use regular printer paper instead.",
              "url": "https://origami.me/rectangle-paper-to-square/"
            }
          ],
          "guide_id": null
        }
      ],
      "guide_id": null,
      "verify": null,
      "requires": []
