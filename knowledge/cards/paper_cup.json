    {
      "id": "pinch",
      "title": "Pinch the left edge",
      "cue": {
        "line1": "FOLD LEFT EDGE DOWN",
        "line2": "ONLY PINCH AT RIGHT EDGE"
      },
      "detail": "Temporarily bring the top layer's left sloping edge onto the triangle's bottom edge. Make only a short pinch where that temporary fold reaches the right sloping edge, then reopen the layer. The original diagrams show the reference mark; they do not show your actual paper. Based on origami.me, Step 2.",
      "why": {
        "line1": "MAKES A SMALL",
        "line2": "REFERENCE POINT"
      },
      "where": {
        "line1": "TOP LAYER, LEFT EDGE",
        "line2": ""
      },
      "warnings": [],
      "faq": [
        {
          "q": "what is a pinch",
          "a": {
            "line1": "ONLY A SMALL MARK",
            "line2": "NOT A FULL CREASE"
          }
        }
      ],
      "troubleshoot": [
        {
          "when": [],
          "action": {
            "line1": "CHECK ONLY A PINCH",
            "line2": "NOT A FULL FOLD"
          },
          "why": "The source says to pinch, which makes a small reference point.",
          "cites": [
            {
              "source": "origami_me_cup",
              "loc": "Step 2",
              "quote": "but only pinch at the right edge level. This creates a small reference point.",
              "url": "https://origami.me/cup/"
            }
          ],
          "guide_id": "cup_pinch"
        }
      ],
      "guide_id": "cup_pinch",
